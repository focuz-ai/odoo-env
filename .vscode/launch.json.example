{
    // VSCode Launch Configurations for Odoo Master Development
    // Copy to launch.json and customize paths as needed
    // Docs: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Odoo: Development",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/odoo/odoo-bin",
            "args": [
                "-c", "${workspaceFolder}/config/dev.conf",
                "--dev=all"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/odoo",
                "LANG": "es_PE.UTF-8",
                "LC_ALL": "es_PE.UTF-8",
                "TZ": "America/Lima"
            },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "pythonArgs": ["-X", "frozen_modules=off"]
        },
        {
            "name": "Odoo: Install Module",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/odoo/odoo-bin",
            "args": [
                "-c", "${workspaceFolder}/config/dev.conf",
                "-d", "<database>",
                "-i", "<module_name>",
                "--stop-after-init"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/odoo",
                "LANG": "es_PE.UTF-8",
                "LC_ALL": "es_PE.UTF-8",
                "TZ": "America/Lima"
            },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "pythonArgs": ["-X", "frozen_modules=off"]
        },
        {
            "name": "Odoo: Update Module",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/odoo/odoo-bin",
            "args": [
                "-c", "${workspaceFolder}/config/dev.conf",
                "-d", "<database>",
                "-u", "<module_name>",
                "--stop-after-init"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/odoo",
                "LANG": "es_PE.UTF-8",
                "LC_ALL": "es_PE.UTF-8",
                "TZ": "America/Lima"
            },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "pythonArgs": ["-X", "frozen_modules=off"]
        },
        {
            "name": "Odoo: Run Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/odoo/odoo-bin",
            "args": [
                "-c", "${workspaceFolder}/config/dev.conf",
                "-d", "<database>",
                "-i", "<module_name>",
                "--test-enable",
                "--stop-after-init",
                "--log-level=test"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/odoo",
                "LANG": "es_PE.UTF-8",
                "LC_ALL": "es_PE.UTF-8",
                "TZ": "America/Lima"
            },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "pythonArgs": ["-X", "frozen_modules=off"]
        },
        {
            "name": "Odoo: Shell (IPython)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/odoo/odoo-bin",
            "args": [
                "shell",
                "-c", "${workspaceFolder}/config/dev.conf",
                "-d", "<database>",
                "--shell-interface", "ipython",
                "--xmlrpc-port", "8888",
                "--gevent-port", "8899"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/odoo",
                "LANG": "es_PE.UTF-8",
                "LC_ALL": "es_PE.UTF-8",
                "TZ": "America/Lima"
            },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "pythonArgs": ["-X", "frozen_modules=off"]
        },
        {
            "name": "Odoo: Scaffold Module",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/odoo/odoo-bin",
            "args": [
                "scaffold",
                "<module_name>",
                "${workspaceFolder}/src/dev/"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
